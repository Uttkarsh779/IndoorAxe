# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://uttkarshtiwari01_db_user:oAYO4RMFD5m9nkI9@indooraxe.iokfmkl.mongodb.net/indooraxe?appName=Indooraxe

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=indooraxe_token

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Razorpay (the original repo had a LIVE key hardcoded in source - rotate it before going live)
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me

# First Google account to log in with this email is auto-promoted to admin.
BOOTSTRAP_ADMIN_EMAIL=
# Only used by `npm run seed` (backend/src/utils/seed.js), which creates a
# separate local-password admin login (POST /api/auth/admin-login) alongside
# Google login - set a strong password, then run `npm run seed` once.
BOOTSTRAP_ADMIN_PASSWORD=
